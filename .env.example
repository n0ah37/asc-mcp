# App Store Connect API credentials for asc-mcp.
# Copy to `.env` and fill in. Generate an API key in App Store Connect:
#   Users and Access -> Integrations -> App Store Connect API -> Team Keys.

# Your issuer ID (a UUID shown above the keys table). Required.
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# The Key ID of the API key you generated. Required.
ASC_KEY_ID=ABCD123456

# The private key. Provide EITHER the inline PEM contents (ASC_PRIVATE_KEY)
# OR a path to the downloaded .p8 file (ASC_PRIVATE_KEY_PATH). One is required.
#
# Inline (note: keep the BEGIN/END lines and newlines):
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Or by path:
ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_ABCD123456.p8

# Vendor number for download_sales_report / download_finance_report
# (App Store Connect → Payments and Financial Reports, top left).
# ASC_VENDOR_NUMBER=85000000

# Optional: override the API origin (rarely needed).
# ASC_BASE_URL=https://api.appstoreconnect.apple.com

# Optional: log level/filter for tracing (written to stderr). Default: info.
# ASC_LOG=debug

# ---- Which tools to serve ---------------------------------------------------
# Fewer tools means less context spent on definitions the agent will never use.

# Comma-separated groups, or the preset `core` (generic, apps, versions, assets,
# testflight, submission) or `all`. Default: all.
# Groups: generic, apps, iap, subscriptions, versions, pricing, availability,
#         submission, testflight, provisioning, assets, offers, offer-codes,
#         promotions, reviews, users, events, xcode-cloud, analytics,
#         custom-product-pages
# ASC_TOOLS=core

# Serve only tools that cannot modify the account. `appstore_request` is kept but
# refuses any method other than GET. Default: 0.
# ASC_READ_ONLY=1

# Show only search_tools, get_tool_details, and call_discovered_tool in
# tools/list. Searches and calls still obey ASC_TOOLS and ASC_READ_ONLY.
# call_discovered_tool can modify account data when read-only mode is off;
# approve writes using the inspected tool's safety annotations. Default: 0.
# ASC_TOOL_DISCOVERY=1

# ---- Tuning -----------------------------------------------------------------
# Sensible defaults; set these only if you have a reason to.

# Whole-request timeout in seconds (0 disables). Default: 60.
# ASC_TIMEOUT_SECS=60

# Connect timeout in seconds (0 disables). Default: 10.
# ASC_CONNECT_TIMEOUT_SECS=10

# Timeout for bulk transfers — asset uploads and report downloads. Default: 300.
# ASC_TRANSFER_TIMEOUT_SECS=300

# Retries after the first attempt, for rate limits and transient failures
# (never for a POST that may already have been applied). Default: 3.
# ASC_MAX_RETRIES=3

# Cap on a tool result's size in bytes; oversized responses shed `included` and
# then trailing `data` items and say so (0 disables). Default: 60000.
# ASC_MAX_RESPONSE_BYTES=60000

# Strip redundant JSON:API `links` from responses. Default: 1.
# ASC_COMPACT_RESPONSES=1
